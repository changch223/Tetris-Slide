    "KEY_ABOUT_BODY_1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 10x10 slide-merge puzzle with block pieces of varied shapes. Swipe to slide every cell on the board, and clear horizontal rows to score."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2048 のスライド操作とさまざまな形のブロックを融合した 10×10 のパズル。スワイプすると盤面のすべてのマスが滑り、横一列をそろえると消えてスコアになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10x10 棋盘上将 2048 的滑动玩法与各种形状的方块融合的解谜游戏。滑动一次,所有方块都会滑到尽头;横向整行被填满即可消除得分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10x10 棋盤上把 2048 的滑動操作與各種形狀的方塊融合的解謎遊戲。滑動一次,所有方塊都會滑到盡頭,橫向整列被填滿即可消除得分。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "10x10 棋盤上把 2048 的滑動操作與各種形狀的方塊融合的解謎遊戲。滑動一次,所有方塊都會滑到盡頭,橫向整列被填滿即可消除得分。"
          }
        }
      }
    },
    "KEY_ABOUT_BODY_2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieces appear automatically in random empty cells. The game ends when no piece can fit anymore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピースは盤面の空いたマスに自動で出現します。どこにも置けなくなるとゲーム終了です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方块会自动落在棋盘上随机的空位。当下一个方块在所有旋转下都无法放入时,游戏结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方塊會自動落在棋盤上隨機的空位。當下一個方塊在所有旋轉下都無法放入時,遊戲結束。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "方塊會自動落在棋盤上隨機的空位。當下一個方塊在所有旋轉下都無法放入時,遊戲結束。"
          }
        }
      }
    },
