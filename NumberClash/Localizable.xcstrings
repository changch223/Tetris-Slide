{
  "sourceLanguage": "en",
  "strings": {
    "%lld": {},
    "BOARD_A11Y_LABEL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game board, 10 by 10. Swipe in any direction to slide all blocks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム盤、10×10。任意の方向にスワイプすると全ブロックが滑ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏棋盘,10 × 10。向任意方向滑动可移动全部方块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲棋盤,10 × 10。向任意方向滑動可移動全部方塊。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲棋盤,10 × 10。向任意方向滑動可移動全部方塊。"
          }
        }
      }
    },
