"rule_classic_1" = "1. Slide tiles to merge identical numbers (e.g. 2 + 2 = 4).";
"rule_classic_2" = "2. The red tile is an obstacle, its initial value depends on the difficulty (Easy: 2048, Medium: 4096).";
